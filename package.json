{
  "name": "ts-eslint-prettier-jest-minimal",
  "version": "1.0.0",
  "description": "TypeScript template with ESLint, Prettier and Jest",
  "main": "lib/index.js",
  "scripts": {
    "start": "node lib/index.js",
    "prepare": "husky install",
    "dev": "tsc --watch",
    "dev:react": "vite",
    "build": "npm run clean && tsc -b",
    "build:react": "vite build",
    "preview:react": "vite preview",
    "clean": "rm -rf lib coverage dist",
    "analyze": "npm run lint:fix && npm run compile",
    "compile": "tsc --noEmit",
    "compile:watch": "tsc --noEmit --watch",
    "compile:build": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint-staged": "lint-staged",
    "lint-staged:debug": "lint-staged --debug",
    "format": "prettier --config .prettierrc '**/*.+(ts|tsx)'",
    "format:check": "prettier --config .prettierrc '**/*.+(ts|tsx)' --check",
    "format:fix": "prettier --config .prettierrc '**/*.+(ts|tsx)' --write",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "validate": "npm run compile && npm run lint && npm run test",
    "upgrade": "ncu -i",
    "upgrade:all": "ncu -u"
  },
  "author": "Softwarecrafters.io",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/jest": "30.0.0",
    "@types/node": "24.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.3",
    "husky": "9.1.7",
    "jest": "30.0.5",
    "lint-staged": "16.1.2",
    "lucide-react": "^0.555.0",
    "npm-check-updates": "18.0.2",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "29.4.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.3",
    "vite": "^7.2.4"
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
